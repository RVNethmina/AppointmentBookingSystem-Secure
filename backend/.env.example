# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=4000

# MongoDB connection string (without the database name)
MONGODB_URI=

# Cloudinary media storage
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# JWT signing secret. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Administrator account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
