# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=4000

# MongoDB connection string (without the database name)
MONGODB_URI=

# Cloudinary media storage
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# JWT signing secret. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the server refuses to start otherwise.
JWT_SECRET=

# Administrator account. The server refuses to start unless the email is valid
# and the password has at least 12 characters mixing uppercase, lowercase,
# digits and symbols.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# JWT lifetime (default 1d)
JWT_EXPIRES_IN=1d

# Directory for temporary uploads (default: backend/uploads)
UPLOAD_DIR=

# Google sign-in (OpenID Connect): OAuth client ID of type "Web application"
GOOGLE_CLIENT_ID=

# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx).
# Leave empty when the API is reached directly; X-Forwarded-For is then ignored.
TRUST_PROXY=

# Comma-separated browser origins allowed to call the API (CORS).
# Default: http://localhost:5173,http://localhost:5174 (Vite dev servers)
ALLOWED_ORIGINS=
